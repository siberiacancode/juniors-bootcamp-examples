                }
              }
            }
          }
        },
        "summary": "Арендовать автомобиль",
        "tags": ["🏎️ cars"]
      },
      "get": {
        "operationId": "CarsController_getCarRents",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "rents",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CarRentsResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Получить все аренды",
        "tags": ["🏎️ cars"]
      }
    },
    "/api/cars/rent/{carRentId}": {
      "get": {
        "operationId": "CarsController_getCarRent",
        "parameters": [
          {
            "name": "carRentId",
            "required": true,
            "in": "path",
            "description": "Идентификатор аренды",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "rent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CarRent"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Получить аренду",
        "tags": ["🏎️ cars"]
      }
    },
    "/api/cars/rent/cancel": {
      "put": {
        "operationId": "CarsController_cancelCarRent",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelCarRentDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "rent cancel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Отменить аренду",
        "tags": ["🏎️ cars"]
      }
    }
  },
  "info": {
    "title": "juniors bootcamp backend 🔥",
    "description": "Апи для выполнения индивидуальных заданий",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": ""
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateOtpDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "89990009999"
          }
        },
        "required": ["phone"]
      },
      "OtpResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Статус запроса"
          },
          "reason": {
            "type": "string",
            "description": "Причина ошибки"
          },
          "retryDelay": {
            "type": "number",
            "example": 120000,
            "description": "Время запроса повторного отп кода в мс"
          }
        },
        "required": ["success", "retryDelay"]
      },
      "SignInDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "89990009999",
            "description": "Номер телефона"
          },
          "code": {
            "type": "number",
            "example": 345231,
            "description": "Отп код"
          }
        },
        "required": ["phone", "code"]
      },
      "User": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "description": "ID пользователя"
          },
          "phone": {
            "type": "string",
            "example": "89990009999",
            "description": "Номер телефона"
          },
          "firstname": {
            "type": "string",
            "example": "firstname",
            "description": "Имя"
          },
          "middlename": {
            "type": "string",
            "example": "middlename",
            "description": "Отчество"
          },
          "lastname": {
            "type": "string",
            "example": "lastname",
            "description": "Фамилия"
          },
          "email": {
            "type": "string",
            "example": "email@gmail.com",
            "description": "Почта"
          },
          "city": {
            "type": "string",
            "example": "city",
            "description": "Город"
          }
        },
        "required": ["_id", "phone"]
      },
      "SignInResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Статус запроса"
          },
          "reason": {
            "type": "string",
            "description": "Причина ошибки"
          },
          "user": {
            "description": "Пользователь",
            "allOf": [
              {
                "$ref": "#/components/schemas/User"
              }
            ]
          },
          "token": {
            "type": "string",
            "description": "Пользовательский токен"
          }
        },
        "required": ["success", "user", "token"]
      },
      "UpdateProfileProfileDto": {
        "type": "object",
        "properties": {
          "firstname": {
            "type": "string",
            "example": "firstname",
            "description": "Имя"
          },
          "middlename": {
            "type": "string",
            "example": "middlename",
            "description": "Отчество"
          },
          "lastname": {
            "type": "string",
            "example": "lastname",
            "description": "Фамилия"
          },
          "email": {
            "type": "string",
            "example": "email@gmail.com",
            "description": "Почта"
          },
          "city": {
            "type": "string",
            "example": "city",
            "description": "Город"
          }
        }
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "profile": {
            "description": "Данные пользователя",
            "allOf": [
              {
                "$ref": "#/components/schemas/UpdateProfileProfileDto"
              }
            ]
          },
          "phone": {
            "type": "string",
            "example": "89990009999",
            "description": "Номер телефона"
          }
        },
        "required": ["profile", "phone"]
      },
      "UpdateProfileResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Статус запроса"
          },
          "reason": {
            "type": "string",
            "description": "Причина ошибки"
          },
          "user": {
            "description": "Пользователь",
            "allOf": [
              {
                "$ref": "#/components/schemas/User"
              }
            ]
          }
        },
        "required": ["success", "user"]
      },
      "SessionResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Статус запроса"
          },
          "reason": {
            "type": "string",
            "description": "Причина ошибки"
          },
          "user": {
            "description": "Пользователь",
            "allOf": [
              {
                "$ref": "#/components/schemas/User"
              }
            ]
          }
        },
        "required": ["success", "user"]
      },
      "Media": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "example": "/static/images/cars/haval-jolion.webp"
          },
          "isCover": {
            "type": "boolean",
            "example": true
          }
        },
        "required": ["url", "isCover"]
      },
      "Car": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "1",
            "description": "ID автомобиля"
          },
          "name": {
            "type": "string",
            "example": "Model X",
            "description": "Название модели"
          },
          "brand": {
            "type": "string",
            "enum": [
              "Haval",
              "Hyundai",
              "Volkswagen",
              "Kia",
              "Geely",
              "Mercedes",
              "Garden car",
              "Grocery cart",
              "Haier",
              "Invalid"
            ],
            "description": "Марка автомобиля"
          },
          "media": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Media"
            }
          },
          "transmission": {
            "type": "string",
            "enum": ["automatic", "manual"],
            "description": "Тип коробки передач"
          },
          "price": {
            "type": "number",
            "example": 15000,
            "description": "Цена аренды в сутки"
          },
          "location": {
            "type": "string",
            "example": "Москва, ул. Пушкина 10",
            "description": "Местоположение"
          },
          "color": {
            "type": "string",
            "enum": ["black", "white", "red", "silver", "blue", "grey", "orange"],
            "description": "Цвет автомобиля"
          },
          "bodyType": {
            "type": "string",
            "enum": ["sedan", "suv", "coupe", "hatchback", "cabriolet"],
            "description": "Тип кузова"
          },
          "steering": {
            "type": "string",
            "enum": ["left", "right"],
            "description": "Расположение руля"
          }
        },
        "required": [
          "id",
          "name",
          "brand",
          "media",
          "transmission",
          "price",
          "location",
          "color",
          "bodyType",
          "steering"
        ]
      },
      "CarsPaginationMeta": {
        "type": "object",
        "properties": {
          "total": {
            "type": "number",
            "example": 100,
            "description": "Общее количество элементов во всех страницах"
          },
          "page": {
            "type": "number",
            "example": 1,
            "description": "Текущий номер страницы (по умолчанию 1)"
          },
          "limit": {
            "type": "number",
            "example": 10,
            "description": "Количество элементов на странице (по умолчанию 10)"
          },
          "totalPages": {
            "type": "number",
            "example": 10,
            "description": "Общее количество доступных страниц"
          }
        },
        "required": ["total", "page", "limit", "totalPages"]
      },
      "CarsPaginatedResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Статус запроса"
          },
          "reason": {
            "type": "string",
            "description": "Причина ошибки"
          },
          "data": {
            "description": "Массив автомобилей с информацией",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Car"
            }
          },
          "meta": {
            "description": "Метаданные пагинации (общее количество, текущая страница и т.д.)",
            "allOf": [
              {
                "$ref": "#/components/schemas/CarsPaginationMeta"
              }
            ]
          }
        },
        "required": ["success", "data", "meta"]
      },
      "BookedDateRange": {
        "type": "object",
        "properties": {
          "startDate": {
            "type": "number",
            "description": "Дата начала аренды (timestamp)",
            "example": 1717236000000
          },
          "endDate": {
            "type": "number",
            "description": "Дата окончания аренды (timestamp)",
            "example": 1717610400000
          }
        },
        "required": ["startDate", "endDate"]
      },
      "CarWithRents": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "1",
            "description": "ID автомобиля"
          },
          "name": {
            "type": "string",
            "example": "Model X",
            "description": "Название модели"
          },
          "brand": {
            "type": "string",
            "enum": [
              "Haval",
              "Hyundai",
              "Volkswagen",
              "Kia",
              "Geely",
              "Mercedes",
              "Garden car",
              "Grocery cart",
              "Haier",
              "Invalid"
            ],
            "description": "Марка автомобиля"
          },
          "media": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Media"
            }
          },
          "transmission": {
            "type": "string",
            "enum": ["automatic", "manual"],
            "description": "Тип коробки передач"
          },
          "price": {
            "type": "number",
            "example": 15000,
            "description": "Цена аренды в сутки"
          },
          "location": {
            "type": "string",
            "example": "Москва, ул. Пушкина 10",
            "description": "Местоположение"
          },
          "color": {
            "type": "string",
            "enum": ["black", "white", "red", "silver", "blue", "grey", "orange"],
            "description": "Цвет автомобиля"
          },
          "bodyType": {
            "type": "string",
            "enum": ["sedan", "suv", "coupe", "hatchback", "cabriolet"],
            "description": "Тип кузова"
          },
          "steering": {
            "type": "string",
            "enum": ["left", "right"],
            "description": "Расположение руля"
          },
          "rents": {
            "description": "Занятые промежутки дат (timestamp)",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookedDateRange"
            }
          }
        },
        "required": [
          "id",
          "name",
          "brand",
          "media",
          "transmission",
          "price",
          "location",
          "color",
          "bodyType",
          "steering",
          "rents"
        ]
      },
      "CarResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Статус запроса"
          },
          "reason": {
            "type": "string",
            "description": "Причина ошибки"
          },
          "data": {
            "description": "Данные автомобиля с арендованными датами",
            "allOf": [
              {
                "$ref": "#/components/schemas/CarWithRents"
              }
            ]
          }
        },
        "required": ["success", "data"]
      },
      "CreateRentDto": {
        "type": "object",
        "properties": {
          "carId": {
            "type": "string",
            "example": "car123",
            "description": "Идентификатор автомобиля"
          },
          "pickupLocation": {
            "type": "string",
            "example": "Москва, ул. Ленина, 12",
            "description": "Место получения автомобиля"
          },
          "returnLocation": {
            "type": "string",
            "example": "Москва, ул. Тверская, 15",
            "description": "Место возврата автомобиля"
          },
          "startDate": {
            "type": "number",
            "example": 1717236000000,
            "description": "Дата начала аренды (timestamp в миллисекундах)"
          },
          "endDate": {
